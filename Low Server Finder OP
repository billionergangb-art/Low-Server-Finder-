-- Function para limpyohan ang daan nga listahan
local function ClearList()
    for _, child in ipairs(ServerScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
end

-- Function para mangita ug magbutang sa mga server nga 1 ra ang tawo sa listahan
local function ScanServers()
    ScanButton.Text = "Scanning servers..."
    ClearList()
    
    local cursor = ""
    local foundCount = 0

    for i = 1, 3 do -- Limitado sa pipila ka pages aron dili malowow
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end

        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            for _, server in ipairs(result.data) do
                -- Kung 1 ra ang nagdula ug dili ang current server
                if server.playing == 1 and server.id ~= game.JobId then
                    foundCount = foundCount + 1

                    -- Server Item Row
                    local ItemFrame = Instance.new("Frame")
                    ItemFrame.Parent = ServerScroll
                    ItemFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    ItemFrame.BorderColor3 = Color3.fromRGB(70, 70, 70)
                    ItemFrame.Size = UDim2.new(1, -6, 0, 28)

                    -- Server Info Label (Ping / ID snippet)
                    local InfoLabel = Instance.new("TextLabel")
                    InfoLabel.Parent = ItemFrame
                    InfoLabel.BackgroundTransparency = 1
                    InfoLabel.Position = UDim2.new(0, 6, 0, 0)
                    InfoLabel.Size = UDim2.new(0, 150, 1, 0)
                    InfoLabel.Font = Enum.Font.SourceSans
                    InfoLabel.Text = "Player: 1 | Ping: " .. (server.ping or "N/A")
                    InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
                    InfoLabel.TextSize = 11
                    InfoLabel.TextXAlignment = Enum.TextXAlignment.Left

                    -- Join Button sa Kilid
                    local JoinBtn = Instance.new("TextButton")
                    JoinBtn.Parent = ItemFrame
                    JoinBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 160)
                    JoinBtn.BorderColor3 = Color3.fromRGB(0, 130, 200)
                    JoinBtn.Position = UDim2.new(1, -70, 0, 3)
                    JoinBtn.Size = UDim2.new(0, 65, 1, -6)
                    JoinBtn.Font = Enum.Font.SourceSansBold
                    JoinBtn.Text = "JOIN"
                    JoinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    JoinBtn.TextSize = 11

                    local serverId = server.id
                    JoinBtn.MouseButton1Click:Connect(function()
                        JoinBtn.Text = "Joining..."
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LocalPlayer)
                    end)
                end
            end
            cursor = result.nextPageCursor
            if not cursor then break end
        else
            break
        end
        task.wait(0.1)
    end

    ServerScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    if foundCount == 0 then
        ScanButton.Text = "No 1-player server found. Rescan"
    else
        ScanButton.Text = "Scan Complete (" .. foundCount .. " found)"
    end
end

-- Button Click Events
ScanButton.MouseButton1Click:Connect(function()
    task.spawn(ScanServers)
end)

HideBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
